---
// Free GED readiness quiz
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizPage from '../components/QuizPage.astro';
import { quiz as q } from '../data/quiz';
---
<BaseLayout
  path="/ged-readiness-quiz/"
  title={q.meta.title}
  description={q.meta.description}
  faqItems={q.faqs}
>
  <QuizPage />
</BaseLayout>
